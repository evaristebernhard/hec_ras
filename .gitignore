# Python environment and caches
.venv/
__pycache__/
*.py[cod]

# Source CAD is retained locally; Git tracks only derived evidence and delivery files.
data/raw/cad/*
!data/raw/cad/.gitkeep
data/intermediate/dxf/*.dxf
data/intermediate/dxf/*.dxf~
data/intermediate/dxf/logs/
data/intermediate/dxf/original-fonts/

# HEC-RAS input text is versioned; solver run/HDF payloads remain local.
models/main/*.hdf
models/main/*.O??
models/main/*.r??
models/main/ras_prepare_dialogs.log
models/boundary_sensitivity/*.hdf
models/boundary_sensitivity/*.O??
models/boundary_sensitivity/*.r??
models/boundary_sensitivity/ras_prepare_dialogs.log

# LaTeX and rendering intermediates
report/*.aux
report/*.log
report/*.toc
report/*.out
report/*.xdv
report/*.fls
report/*.fdb_latexmk
report/rendered/
report/cad_render/

# Editor/OS autosaves and local CAD font cache
.DS_Store
Thumbs.db
*~
deliverables/cad/design_bed/\#*
.librecad-fonts/
